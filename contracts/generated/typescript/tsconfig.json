{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": false
  },
  "include": [
    "console-openapi/**/*.ts",
    "openapi/**/*.ts",
    "platform-openapi/**/*.ts",
    "proto/**/*.ts",
    "runtime-target-openapi/**/*.ts",
    "storage-openapi/**/*.ts"
  ]
}
