{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hnb.cloud/console/v1/cluster-dictionaries.schema.json",
  "title": "ClusterDictionaries",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dictionaries", "statusCompatibilityAggregation"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "dictionaries": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dictionaryId", "version", "entries"],
        "properties": {
          "dictionaryId": { "type": "string", "pattern": "^resource\\.cluster\\.(lifecycle|health|connectivity|freshness|status)$" },
          "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
          "compatibilityOnly": { "type": "boolean" },
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "$ref": "dictionary-entry.schema.json" }
          }
        }
      }
    },
    "statusCompatibilityAggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dictionaryId", "displayOnly", "preservesDimensions", "precedence"],
      "properties": {
        "dictionaryId": { "const": "resource.cluster.status" },
        "displayOnly": { "const": true },
        "preservesDimensions": { "const": true },
        "precedence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when", "code"],
            "properties": {
              "when": { "type": "string", "minLength": 1, "maxLength": 256 },
              "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
            }
          }
        }
      }
    }
  }
}
