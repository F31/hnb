  "statusCompatibilityAggregation": {
    "dictionaryId": "resource.cluster.status",
    "displayOnly": true,
    "preservesDimensions": true,
    "precedence": [
      { "when": "freshness == STALE", "code": "STALE" },
      { "when": "lifecycleState == TERMINATED", "code": "TERMINATED" },
      { "when": "lifecycleState == DELETING", "code": "DELETING" },
      { "when": "lifecycleState == FAILED", "code": "FAILED" },
      { "when": "lifecycleState == UPGRADING", "code": "UPGRADING" },
      { "when": "lifecycleState == PROVISIONING", "code": "PROVISIONING" },
      { "when": "lifecycleState == REGISTERING", "code": "REGISTERING" },
      { "when": "healthState in [DEGRADED, UNHEALTHY] || connectivityState == DISCONNECTED", "code": "DEGRADED" },
      { "when": "lifecycleState == ACTIVE && healthState == HEALTHY", "code": "RUNNING" },
      { "when": "otherwise", "code": "UNKNOWN" }
    ]
  }
