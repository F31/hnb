{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hnb.cloud/storage/v1/storage-class-binding.schema.json",
  "title": "StorageClassBinding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "tenantId", "offeringId", "offeringVersion", "targetId", "bindingTarget", "storageClassName", "storageClassUid", "storageClassResourceVersion", "syncState", "isDefault", "source", "observedAt", "freshness", "conditions", "version", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "format": "uuid" },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "offeringId": { "type": "string", "format": "uuid" },
    "offeringVersion": { "type": "integer", "minimum": 1 },
    "targetId": { "type": "string", "format": "uuid" },
    "bindingTarget": { "const": "KubernetesStorageClass" },
    "storageClassName": { "type": "string", "minLength": 1, "maxLength": 253 },
    "storageClassUid": { "type": "string", "minLength": 1, "maxLength": 128 },
    "storageClassResourceVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "syncState": { "enum": ["Discovered", "Imported", "Active", "Drifted", "Rejected", "Retired"] },
    "isDefault": { "type": "boolean" },
    "source": { "type": "string", "minLength": 1, "maxLength": 256 },
    "freshness": { "enum": ["Fresh", "Stale", "Unknown"] },
    "topology": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "minLength": 1, "maxLength": 128 },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "conditions": { "type": "array", "maxItems": 64, "items": { "$ref": "storage-condition.schema.json" } },
    "version": { "type": "integer", "minimum": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
