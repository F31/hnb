{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hnb.cloud/storage/v1/storage-driver-lifecycle-step-input.schema.json",
  "title": "StorageDriverLifecycleStepInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "action", "installationId", "packageId", "packageVersion", "packageDigest", "provisioners", "capabilityClaims", "targetId", "targetKind", "targetProjectionVersion", "kubernetesVersion", "idempotencyKey", "fencingGeneration"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "action": { "enum": ["install", "upgrade", "uninstall"] },
    "installationId": { "type": "string", "format": "uuid" },
    "packageId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "packageVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "currentVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "rollbackVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "packageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "provisioners": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 253 } },
    "capabilityClaims": { "type": "object" },
    "targetId": { "type": "string", "format": "uuid" },
    "targetKind": { "const": "KubernetesTarget" },
    "targetProjectionVersion": { "type": "integer", "minimum": 1 },
    "kubernetesVersion": { "type": "string", "pattern": "^v?\\d+\\.\\d+\\.\\d+$" },
    "parameters": { "type": "object", "maxProperties": 32 },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
    "fencingGeneration": { "type": "integer", "minimum": 1 }
  }
}
