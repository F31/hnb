{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hnb.cloud/storage/v1/storage-driver-package.schema.json",
  "title": "StorageDriverPackage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "packageVersion",
    "provisioners",
    "compatibility",
    "capabilities",
    "requiredComponents",
    "packageDigest",
    "signature",
    "conformanceEvidence"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "packageId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "packageVersion": { "$ref": "#/$defs/semanticVersion" },
    "provisioners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$" }
    },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "requiredComponents": { "$ref": "#/$defs/requiredComponents" },
    "packageDigest": { "$ref": "#/$defs/digest" },
    "signature": { "$ref": "#/$defs/signature" },
    "conformanceEvidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/conformanceEvidence" }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "versionRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minInclusive", "maxExclusive"],
      "properties": {
        "minInclusive": { "$ref": "#/$defs/semanticVersion" },
        "maxExclusive": { "$ref": "#/$defs/semanticVersion" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kubernetesVersions", "upgradeFromVersions", "rollbackToVersions"],
      "properties": {
        "kubernetesVersions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/versionRange" }
        },
        "upgradeFromVersions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/semanticVersion" }
        },
        "rollbackToVersions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/semanticVersion" }
        }
      }
    },
    "supportClaim": { "enum": ["Supported", "Unsupported"] },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "volumeModes",
        "accessModes",
        "topology",
        "capacityTracking",
        "expansion",
        "clone",
        "snapshot",
        "ephemeral",
        "health"
      ],
      "properties": {
        "volumeModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["Block", "File"] }
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] }
        },
        "topology": { "$ref": "#/$defs/supportClaim" },
        "capacityTracking": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["CSIStorageCapacity", "Provider", "NodeInventory", "None"] }
        },
        "expansion": { "$ref": "#/$defs/supportClaim" },
        "clone": { "$ref": "#/$defs/supportClaim" },
        "snapshot": { "$ref": "#/$defs/supportClaim" },
        "ephemeral": { "$ref": "#/$defs/supportClaim" },
        "health": { "$ref": "#/$defs/supportClaim" }
      }
    },
    "componentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "versions"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 253 },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "requiredComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crds", "controllers"],
      "properties": {
        "crds": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/componentRequirement" }
        },
        "controllers": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/componentRequirement" }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "keyId", "signedDigest", "evidenceRef"],
      "properties": {
        "format": { "enum": ["Cosign", "Notation", "X509"] },
        "keyId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "signedDigest": { "$ref": "#/$defs/digest" },
        "evidenceRef": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "conformanceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageVersion",
        "kubernetesVersion",
        "suiteVersion",
        "passedAt",
        "expiresAt",
        "evidenceRef",
        "evidenceDigest"
      ],
      "properties": {
        "packageVersion": { "$ref": "#/$defs/semanticVersion" },
        "kubernetesVersion": { "$ref": "#/$defs/semanticVersion" },
        "suiteVersion": { "$ref": "#/$defs/semanticVersion" },
        "passedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "evidenceRef": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "evidenceDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
