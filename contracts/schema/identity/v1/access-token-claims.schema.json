{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hnb.cloud/identity/v1/access-token-claims.schema.json",
  "title": "AccessTokenClaims",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileVersion", "issuer", "audiences", "subjectId", "subjectType", "tenantId", "membershipId", "tenantMembershipIds", "policyVersion", "scopedPermissions", "issuedAt", "expiresAt", "notBefore", "authTime", "tokenId", "keyId", "algorithm"],
  "properties": {
    "profileVersion": { "const": "hnb.identity/v1" },
    "issuer": { "type": "string", "format": "uri", "maxLength": 512 },
    "audiences": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "subjectId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "subjectType": { "enum": ["user", "workload", "service"] },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "membershipId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tenantMembershipIds": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "policyVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "scopedPermissions": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "../../platform/v1/scoped-permission.schema.json" }
    },
    "allowedActions": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "enum": ["read", "list", "create", "update", "delete", "execute", "approve", "reject", "cancel", "switchTenant"] } },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "notBefore": { "type": "string", "format": "date-time" },
    "authTime": { "type": "string", "format": "date-time" },
    "tokenId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "keyId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "algorithm": { "const": "ES256" }
  },
  "allOf": [
    {
      "if": { "properties": { "subjectType": { "enum": ["workload", "service"] } }, "required": ["subjectType"] },
      "then": { "properties": { "allowedActions": {} }, "required": ["allowedActions"] }
    }
  ]
}
