{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hnb.cloud/identity/v1/secret-reference.schema.json",
  "title": "SecretReference",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tenantId", "name", "secretRef", "version"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "tenantId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "secretRef": { "type": "string", "pattern": "^secret://tenant/[a-zA-Z0-9_-]+/[a-zA-Z0-9_-]+$" },
    "description": { "type": "string", "maxLength": 1024 },
    "encryptedValue": { "type": "string", "minLength": 1 },
    "algorithm": { "type": "string", "enum": ["AES-256-GCM"] },
    "version": { "type": "integer", "minimum": 1 },
    "rotationPolicy": {
      "type": "object",
      "properties": {
        "interval": { "type": "string", "pattern": "^[0-9]+[smhd]$" },
        "autoRotate": { "type": "boolean" }
      }
    },
    "expiresAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}