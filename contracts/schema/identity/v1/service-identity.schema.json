{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hnb.cloud/identity/v1/service-identity.schema.json",
  "title": "ServiceIdentity",
  "type": "object",
  "additionalProperties": false,
  "required": ["subjectId", "subjectType", "audiences", "allowedActions", "tenantIds", "scopedPermissions"],
  "properties": {
    "subjectId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "subjectType": { "enum": ["workload", "service"] },
    "audiences": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "allowedActions": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "enum": ["read", "list", "create", "update", "delete", "execute", "approve", "reject", "cancel", "switchTenant"] } },
    "tenantIds": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "const": "*" } } },
    "scopedPermissions": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "../../platform/v1/scoped-permission.schema.json" } }
  }
}
