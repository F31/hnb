{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hnb.cloud/identity/v1/service-credential.schema.json",
  "title": "IssuedServiceCredential",
  "description": "One short-lived credential issued for an exact registered service identity. The credential value is returned once to the caller and must not be logged or persisted by consumers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credential", "credentialId", "serviceIdentityId", "subjectId",
    "tenantId", "audience", "permission", "issuedAt", "expiresAt", "expiresIn"
  ],
  "properties": {
    "credential": { "type": "string", "minLength": 1, "maxLength": 8192, "writeOnly": true },
    "credentialId": { "type": "string", "format": "uuid" },
    "serviceIdentityId": { "type": "string", "format": "uuid" },
    "subjectId": { "type": "string", "format": "uuid" },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "const": "*" } },
    "audience": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[!-)+-~]+$", "not": { "const": "*" }
    },
    "permission": { "$ref": "../../platform/v1/scoped-permission.schema.json" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "expiresIn": { "type": "integer", "minimum": 1, "maximum": 60 }
  }
}
