{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hnb.cloud/identity/v1/service-credential-scope.schema.json",
  "title": "ServiceCredentialScope",
  "description": "One exact service credential consumer scope. This is not proof of workload identity or permission to issue a credential.",
  "type": "object",
  "additionalProperties": false,
  "required": ["subjectId", "audience", "permission"],
  "properties": {
    "subjectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[!-)+-~]+$" },
    "audience": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[!-)+-~]+$" },
    "permission": {
      "allOf": [
        { "$ref": "../../platform/v1/scoped-permission.schema.json" },
        {
          "type": "object",
          "required": ["tenantId", "resourceKind", "resourceId", "action"],
          "properties": {
            "tenantId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[!-)+-~]+$" },
            "resourceKind": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$" },
            "resourceId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[!-)+-~]+$" },
            "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[!-)+-~]+$" },
            "environmentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[!-)+-~]+$" },
            "namespaceId": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[!-)+-~]+$" }
          },
          "dependentRequired": { "environmentId": ["projectId"], "namespaceId": ["environmentId"] }
        }
      ]
    }
  }
}
