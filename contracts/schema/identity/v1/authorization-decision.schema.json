{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hnb.cloud/identity/v1/authorization-decision.schema.json",
  "title": "AuthorizationDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "reasonCode", "policyVersion", "resourceKind", "action", "scope"],
  "properties": {
    "decision": { "enum": ["allow", "deny"] },
    "reasonCode": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z][A-Z0-9_]*$" },
    "policyVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "resourceKind": { "type": "string", "minLength": 1, "maxLength": 128 },
    "resourceId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "action": { "enum": ["read", "list", "create", "update", "delete", "execute", "approve", "reject", "cancel", "switchTenant"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId"],
      "properties": {
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "environmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "namespaceId": { "type": "string", "minLength": 1, "maxLength": 253 }
      }
    }
  }
}
