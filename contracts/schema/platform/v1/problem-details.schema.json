{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hnb.cloud/platform/v1/problem-details.schema.json",
  "title": "ProblemDetails",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "title", "status", "code", "correlationId", "traceId"],
  "properties": {
    "type": { "type": "string", "format": "uri-reference", "maxLength": 512 },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "status": { "type": "integer", "minimum": 400, "maximum": 599 },
    "detail": { "type": "string", "maxLength": 4096 },
    "instance": { "type": "string", "format": "uri-reference", "maxLength": 512 },
    "code": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z][A-Z0-9_]*$" },
    "correlationId": { "type": "string", "format": "uuid" },
    "traceId": { "type": "string", "minLength": 16, "maxLength": 64, "pattern": "^[0-9a-f]+$" },
    "retryable": { "type": "boolean" },
    "confirmation": { "type": "string", "minLength": 16, "maxLength": 2048 },
    "targetId": { "type": "string", "format": "uuid" },
    "action": { "type": "string", "maxLength": 128 },
    "lastKnownStateAt": { "type": "string", "format": "date-time" },
    "lifecycleState": { "type": "string", "maxLength": 64 },
    "healthState": { "type": "string", "maxLength": 64 },
    "connectivityState": { "type": "string", "maxLength": 64 },
    "policyOutcome": { "type": "string", "enum": ["allow", "require_approval", "queued_offline", "deny"] },
    "violations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "code"],
        "properties": {
          "field": { "type": "string", "minLength": 1, "maxLength": 256 },
          "code": { "type": "string", "minLength": 1, "maxLength": 128 },
          "message": { "type": "string", "maxLength": 1024 }
        }
      }
    }
  }
}
