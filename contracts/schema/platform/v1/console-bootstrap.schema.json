{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hnb.cloud/platform/v1/console-bootstrap.schema.json",
  "title": "ConsoleBootstrap",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "selectedTenantId", "memberships", "capabilities", "permissions", "policyVersion", "permissionVersion"],
  "properties": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "displayName"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "enum": ["user", "workload", "service"] },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "selectedTenantId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "memberships": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["membershipId", "tenantId", "tenantName"],
        "properties": {
          "membershipId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "tenantId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "tenantName": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "capabilities": { "type": "array", "maxItems": 256, "items": { "$ref": "capability.schema.json" } },
    "permissions": { "type": "array", "maxItems": 1024, "items": { "$ref": "scoped-permission.schema.json" } },
    "policyVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "permissionVersion": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
