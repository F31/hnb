{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hnb.cloud/alert/v1/alert-instance.schema.json",
  "title": "AlertInstance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenantId",
    "source",
    "severity",
    "fingerprint",
    "state",
    "summary",
    "firstSeenAt",
    "lastSeenAt",
    "occurrenceCount",
    "version"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "tenantId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "environmentId": { "type": "string", "minLength": 1 },
    "ruleId": { "type": "string", "format": "uuid" },
    "source": { "type": "string", "minLength": 1 },
    "severity": { "type": "string", "enum": ["critical", "warning", "info"] },
    "resourceRef": { "type": "string", "minLength": 1 },
    "targetId": { "type": "string", "format": "uuid" },
    "resourceKind": { "type": "string", "minLength": 1 },
    "resourceUid": { "type": "string", "minLength": 1 },
    "resourceNamespace": { "type": "string", "minLength": 1 },
    "resourceName": { "type": "string", "minLength": 1 },
    "bindingId": { "type": "string", "format": "uuid" },
    "offeringId": { "type": "string", "format": "uuid" },
    "fingerprint": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "enum": ["pending", "firing", "acknowledged", "silenced", "resolved"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "firstSeenAt": { "type": "string", "format": "date-time" },
    "lastSeenAt": { "type": "string", "format": "date-time" },
    "resolvedAt": { "type": "string", "format": "date-time" },
    "occurrenceCount": { "type": "integer", "minimum": 1 },
    "assigneeId": { "type": "string", "minLength": 1 },
    "acknowledgedBy": { "type": "string", "minLength": 1 },
    "acknowledgedAt": { "type": "string", "format": "date-time" },
    "acknowledgementReason": { "type": "string", "maxLength": 1024 },
    "correlationId": { "type": "string", "format": "uuid" },
    "operationId": { "type": "string", "format": "uuid" },
    "runbookRef": { "type": "string", "minLength": 1 },
    "sourceRef": { "type": "string", "minLength": 1 },
    "labels": { "type": "object", "additionalProperties": { "type": "string" } },
    "version": { "type": "integer", "minimum": 1 }
  }
}
