{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hnb.cloud/readiness/v1/product-readiness.schema.json",
  "title": "ProductReadinessManifest",
  "description": "Offline stage plan and retained evidence contracts. Content validation never grants production certification or execution authority.",
  "oneOf": [{ "$ref": "#/$defs/plan" }, { "$ref": "#/$defs/evidence" }],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "stage": { "type": "string", "enum": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7"] },
    "level": { "type": "string", "enum": ["unit", "db_integration", "real_e2e", "production_ha"] },
    "status": { "type": "string", "enum": ["not_run", "partial", "blocked", "failed", "passed"] },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "sourceDigest", "configurationDigest", "releaseVersion", "artifactDigests"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "configurationDigest": { "$ref": "#/$defs/digest" },
        "releaseVersion": { "$ref": "#/$defs/identifier" },
        "artifactDigests": {
          "type": "object", "minProperties": 1, "maxProperties": 256,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "kubernetesVersion", "compositionId", "profile", "backing", "managementClusterId", "controlPlaneDomainIds", "conditions"],
      "properties": {
        "os": { "$ref": "#/$defs/identifier" },
        "architecture": { "type": "string", "enum": ["amd64", "arm64"] },
        "kubernetesVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "compositionId": { "$ref": "#/$defs/identifier" },
        "profile": { "type": "string", "enum": ["Minimal", "LiteHA", "StandardHA", "Enterprise"] },
        "backing": { "type": "string", "enum": ["bundled", "in-cluster-ha", "external"] },
        "managementClusterId": { "$ref": "#/$defs/identifier" },
        "targetClusterId": { "$ref": "#/$defs/identifier" },
        "conditions": {
          "type": "object", "additionalProperties": false,
          "required": ["hardware", "network", "storage", "load"],
          "properties": {
            "hardware": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "network": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "storage": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "load": { "type": "string", "minLength": 1, "maxLength": 2048 }
          }
        },
        "controlPlaneDomainIds": {
          "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["draft", "approved"] },
        "approvedBy": { "$ref": "#/$defs/identifier" },
        "approvedAt": { "type": "string", "format": "date-time" }
      },
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": { "required": ["approvedBy", "approvedAt"] }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "limit", "comparison", "unit", "windowSeconds", "sampleIntervalSeconds"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "metric": { "$ref": "#/$defs/identifier" },
        "limit": { "type": "number", "minimum": 0 },
        "comparison": { "type": "string", "enum": ["atMost", "atLeast"] },
        "unit": { "$ref": "#/$defs/identifier" },
        "windowSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleIntervalSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "stage", "identity", "scope", "minimumEvidenceLevel", "minimumControlPlaneDomains", "requireIndependentTarget", "requiredAssertions", "budgets", "approval", "validUntil"],
      "properties": {
        "schemaVersion": { "type": "string", "const": "product-readiness/v1" },
        "kind": { "type": "string", "const": "ReadinessPlan" },
        "stage": { "$ref": "#/$defs/stage" },
        "identity": { "$ref": "#/$defs/identity" },
        "scope": { "$ref": "#/$defs/scope" },
        "minimumEvidenceLevel": { "$ref": "#/$defs/level" },
        "minimumControlPlaneDomains": { "type": "integer", "minimum": 1 },
        "requireIndependentTarget": { "type": "boolean" },
        "requiredAssertions": {
          "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "budgets": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/budget" } },
        "approval": { "$ref": "#/$defs/approval" },
        "validUntil": { "type": "string", "format": "date-time" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "reportPath"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "status": { "$ref": "#/$defs/status" },
        "reportPath": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budgetId", "value", "unit", "windowSeconds", "sampleIntervalSeconds", "sampleCount", "reportPath"],
      "properties": {
        "budgetId": { "$ref": "#/$defs/identifier" },
        "value": { "type": "number", "minimum": 0 },
        "unit": { "$ref": "#/$defs/identifier" },
        "windowSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleIntervalSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleCount": { "type": "integer", "minimum": 1 },
        "reportPath": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "stage", "planDigest", "identity", "scope", "level", "status", "startedAt", "finishedAt", "commands", "exitCode", "assertions", "measurements", "reports"],
      "properties": {
        "schemaVersion": { "type": "string", "const": "product-readiness/v1" },
        "kind": { "type": "string", "const": "ReadinessEvidence" },
        "stage": { "$ref": "#/$defs/stage" },
        "planDigest": { "$ref": "#/$defs/digest" },
        "identity": { "$ref": "#/$defs/identity" },
        "scope": { "$ref": "#/$defs/scope" },
        "level": { "$ref": "#/$defs/level" },
        "status": { "$ref": "#/$defs/status" },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "commands": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
        "assertions": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/assertion" } },
        "measurements": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/measurement" } },
        "reports": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/report" } }
      }
    }
  }
}
