{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hnb.cloud/common/v1/event-envelope.schema.json",
  "title": "EventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageId",
    "messageType",
    "schemaVersion",
    "occurredAt",
    "tenantId",
    "correlationId",
    "idempotencyKey"
  ],
  "properties": {
    "messageId": { "type": "string", "format": "uuid" },
    "messageType": { "type": "string", "pattern": "^hnb\\.[a-z0-9.-]+\\.v[1-9][0-9]*$" },
    "schemaVersion": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "tenantId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "environmentId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": { "type": "string", "format": "uuid" },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
    "aggregateId": { "type": "string", "minLength": 1 },
    "aggregateVersion": { "type": "integer", "minimum": 0 },
    "payloadRef": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" }
  },
  "oneOf": [
    { "required": ["payload"] },
    { "required": ["payloadRef"] }
  ]
}
