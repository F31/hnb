{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hnb.cloud/runtime-target/v1/capability-section.schema.json",
  "title": "RuntimeTargetCapabilitySection",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshotId", "digest", "runtimeVersion", "architectures", "resources"],
  "properties": {
    "snapshotId": { "type": "string", "format": "uuid" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "kubernetesVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "kubeEdgeVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "runtimeVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuMillis", "memoryBytes"],
      "properties": {
        "cpuMillis": { "type": "integer", "minimum": 0 },
        "memoryBytes": { "type": "integer", "minimum": 0 },
        "gpuCount": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "npuCount": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "cniPlugins": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "csiDrivers": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "gatewayApiVersions": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "securityFeatures": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "storageClasses": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  }
}
