{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string"
        }
      }
    },
    "enabled": {
      "type": "boolean"
    },
    "planes": {
      "type": "object"
    },
    "storage": {
      "type": "object"
    }
  },
  "required": [
    "image"
  ]
}
