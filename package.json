{
  "name": "hnb-contract-tooling",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.20.2 || ^22.0.0",
    "npm": "^10.8.2 || ^11.0.0"
  },
  "scripts": {
    "contracts:bootstrap": "node scripts/bootstrap-contract-tools.mjs",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check:cluster-management": "node scripts/generate-contracts.mjs --check --cluster-management",
    "contracts:validate": "node scripts/validate-contracts.mjs",
    "contracts:test": "node --test scripts/contracts.test.mjs",
    "contracts:check": "npm run contracts:test && npm run contracts:validate"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@bufbuild/protoc-gen-es": "2.12.1",
    "@redocly/cli": "2.39.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript-codegen": "0.31.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
