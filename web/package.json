{
  "name": "hnb-web-console",
  "private": true,
  "version": "0.1.0",
  "description": "HNB Cloud Native Platform Web Console",
  "scripts": {
    "dev": "pnpm --filter @hnb/shell dev",
    "build": "pnpm --filter @hnb/shell build",
    "build:all": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.10.10",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^25.0.1",
    "naive-ui": "^2.42.0",
    "pinia": "^4.0.2",
    "vitest": "^3.2.7",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  }
}