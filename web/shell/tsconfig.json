{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"],
      "@hnb/types": ["../packages/types/src"],
      "@hnb/types/*": ["../packages/types/src/*"],
      "@hnb/ui-kit": ["../packages/ui-kit/src"],
      "@hnb/ui-kit/*": ["../packages/ui-kit/src/*"],
      "@hnb/api-client": ["../packages/api-client/src"],
      "@hnb/api-client/*": ["../packages/api-client/src/*"],
      "@hnb/schema-engine": ["../packages/schema-engine/src"],
      "@hnb/schema-engine/*": ["../packages/schema-engine/src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"],
}